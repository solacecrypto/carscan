# Copy to .env and fill in. Never commit .env.

# Postgres (the compose file wires these into the postgres container too)
POSTGRES_USER=carscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carscan
DATABASE_URL=postgresql+psycopg://carscan:change-me@postgres:5432/carscan

# Random secret for session cookies / CSRF. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Public domain the site is served on (Caddy obtains the certificate for it)
DOMAIN=cars.example.com

# Claude pass over listing descriptions (phase 6). Leave empty to disable.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
INSIGHTS_PER_RUN=40
# Only fetch detail pages / analyse descriptions for cars with spread >= this (euros)
DETAIL_MIN_SPREAD_EUR=0
INSIGHTS_MIN_SPREAD_EUR=0

# Where cars are collected from: distance, drive time, fuel and tolls per car
BASE_CITY=Utrecht
BASE_POSTCODE=
BASE_COUNTRY=NL
# Photos sent with each Claude call (0 = text only)
INSIGHTS_PHOTOS=4

# English translation of descriptions: google (keyless, default) | deepl | off
TRANSLATE_PROVIDER=google
DEEPL_API_KEY=
TRANSLATE_PER_RUN=6

# Web push for the bell's notifications: `carscan push keygen` prints the three values
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# Nightly database dumps (docs/backups.md). Set the bucket to copy them off the server.
BACKUP_DIR=/srv/backups
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=carscan

# Error reports with stack traces (optional): a Sentry project's DSN
SENTRY_DSN=

# Optional
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=30
